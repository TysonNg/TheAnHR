  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "test:ui": "vitest run tests/ui",
    "test:smoke": "node scripts/smoke.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "package": "npm run build && npm run prepare:ocr && electron-builder --win nsis --x64",
    "package:dir": "npm run build && npm run prepare:ocr && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
